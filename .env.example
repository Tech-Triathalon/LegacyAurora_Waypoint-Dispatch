# Copy to server/.env (local dev) or set in your platform's env settings.
#
# Supabase connection strings:
#   - Port 5432  → direct (for Docker / persistent Node process)
#   - Port 6543  → pgBouncer pooler (for Vercel serverless — avoids "too many connections")
#
# Use the POOLED string (port 6543) when deploying to Vercel.

# --- Production (Vercel + Supabase pooler) ---
# DATABASE_URL  → pgBouncer pooler (port 6543) — used at runtime by Prisma Client
# DIRECT_URL    → direct connection (port 5432) — used by `prisma migrate deploy`
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:YOUR_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=production
PORT=3000

# SSE_TIMEOUT_MS controls how long a /api/stream connection is kept open before
# a graceful reconnect is issued. Default 24000 ms (just under Vercel Pro's 25 s limit).
# Set to 9000 on Vercel Hobby (10 s function timeout).
# SSE_TIMEOUT_MS=24000

# --- Local docker/dev defaults ---
# DATABASE_URL=postgresql://waypoint:waypoint@localhost:5432/waypoint
# JWT_SECRET=waypoint-demo-secret-change-me
# NODE_ENV=development
