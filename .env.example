# Copy to server/.env (local dev) or set in your platform's env settings.
# Supabase: use the pooled connection (port 6543) for serverless, or the
# direct string (port 5432) for a persistent container.

# --- Production (Supabase, direct connection for the Node container) ---
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=production
PORT=3000

# --- Local docker/dev defaults ---
# DATABASE_URL=postgresql://waypoint:waypoint@localhost:5432/waypoint
# JWT_SECRET=waypoint-demo-secret-change-me
# NODE_ENV=development
