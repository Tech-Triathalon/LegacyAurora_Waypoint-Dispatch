{
  "version": 2,
  "buildCommand": "if [ -d server ]; then cd server && npm ci && npx prisma generate; else npm ci && npx prisma generate; fi",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "server/src/**",
          "server/src/data/raw/**",
          "server/prisma/**",
          "server/prisma.config.ts",
          "server/package.json",
          "server/package-lock.json",
          "server/node_modules/**",
          "server/node_modules/.prisma/**",
          "server/node_modules/@prisma/client/**",
          "server/node_modules/@prisma/client/node_modules/**",
          "node_modules/**",
          "node_modules/.prisma/**",
          "node_modules/@prisma/client/**"
        ]
      }
    },
    {
      "src": "client/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/(.*\\.(js|css|html|webmanifest|png|ico|svg|jpg|jpeg|gif|woff2?|json))", "dest": "/client/$1" },
    { "src": "/(.*)", "dest": "/client/$1" }
  ]
}
